# Copy this file to .env for local development. Never commit real credentials.
MONGO_URI=mongodb+srv://<user-name>:<password>@mule-detection.viwyaiu.mongodb.net/
PORT=8000
AI_PROVIDER=mock
# OPENAI_API_KEY=your-key-here (only needed when AI_PROVIDER is configured for OpenAI)

# CORS origin(s) for the frontend. Comma-separated list. Avoid "*" for authenticated requests.
CORS_ORIGIN=http://localhost:5173

# JWT configuration for backend authentication.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h

# Optional: dedicated throwaway database for the MongoDB integration tests.
# MONGO_TEST_URI=mongodb://127.0.0.1:27017/mule_detection_test
